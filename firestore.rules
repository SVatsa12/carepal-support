rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return userDoc().data.role;
    }

    function isMember() {
      return isSignedIn() && role() == 'member';
    }

    function isStaff() {
      return isSignedIn() && role() in ['agent', 'admin'];
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    function isOwner(ticket) {
      return isSignedIn() && ticket.memberId == request.auth.uid;
    }

    function ticketCategories() {
      return ['late_nurse', 'billing', 'schedule_change', 'care_quality', 'app_issue', 'other'];
    }

    function isString(value, minLen, maxLen) {
      return value is string && value.size() >= minLen && value.size() <= maxLen;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---------- Users ----------

    match /users/{uid} {
      allow read: if (isSignedIn() && request.auth.uid == uid) || isStaff();
      // Profiles are created by the seed script (Admin SDK bypasses rules).
      allow write: if false;
    }

    // ---------- Tickets ----------

    match /tickets/{ticketId} {

      function validNewTicket(data) {
        return data.keys().hasAll([
            'ticketNo', 'memberId', 'memberName', 'memberEmail', 'category', 'priority',
            'subject', 'description', 'photoUrl', 'status', 'assigneeId', 'assigneeName',
            'createdAt', 'updatedAt', 'resolvedAt', 'lastMessageAt', 'lastMessagePreview',
            'lastMessageRole', 'awaitingReplyFrom', 'waitingSince', 'unreadMember',
            'unreadStaff', 'rating'
          ])
          // lastEmailAt is written only by the notify service.
          && !data.keys().hasAny(['lastEmailAt'])
          && data.ticketNo == 'TCP-' + ticketId[0:6].upper()
          && data.memberId == request.auth.uid
          && data.memberEmail == request.auth.token.email
          && isString(data.memberName, 1, 100)
          && data.category in ticketCategories()
          && data.priority in ['low', 'medium', 'high', 'urgent']
          && isString(data.subject, 5, 120)
          && isString(data.description, 10, 2000)
          && (data.photoUrl == null
              || (data.photoUrl is string
                  && data.photoUrl.matches('^https://res\\.cloudinary\\.com/.*')))
          && data.status == 'pending'
          && data.assigneeId == null
          && data.assigneeName == null
          && data.createdAt == request.time
          && data.updatedAt == request.time
          && data.lastMessageAt == request.time
          && data.waitingSince == request.time
          && data.resolvedAt == null
          && isString(data.lastMessagePreview, 1, 120)
          && data.lastMessageRole == 'member'
          && data.awaitingReplyFrom == 'staff'
          && data.unreadMember == 0
          && data.unreadStaff == 1
          && data.rating == null;
      }

      // Member sends a message (the ticket half of the send transaction).
      function memberSendMessageShape() {
        return changedKeys().hasOnly([
            'lastMessageAt', 'lastMessagePreview', 'lastMessageRole', 'awaitingReplyFrom',
            'waitingSince', 'unreadStaff', 'updatedAt'
          ])
          && resource.data.status != 'resolved'
          && request.resource.data.lastMessageRole == 'member'
          && request.resource.data.awaitingReplyFrom == 'staff'
          && request.resource.data.unreadStaff == resource.data.unreadStaff + 1
          && isString(request.resource.data.lastMessagePreview, 1, 120);
      }

      // Member opens the thread and clears their own unread counter.
      function memberMarkReadShape() {
        return changedKeys().hasOnly(['unreadMember'])
          && request.resource.data.unreadMember == 0;
      }

      // Member rates a resolved ticket, once.
      function memberRatingShape() {
        let rating = request.resource.data.rating;
        return changedKeys().hasOnly(['rating', 'updatedAt'])
          && resource.data.status == 'resolved'
          && resource.data.rating == null
          && rating.keys().hasOnly(['score', 'comment', 'createdAt'])
          && rating.score is int && rating.score >= 1 && rating.score <= 5
          && rating.comment is string && rating.comment.size() <= 500
          && rating.createdAt == request.time;
      }

      function validStaffUpdate() {
        return !changedKeys().hasAny([
            'memberId', 'memberName', 'memberEmail', 'ticketNo', 'createdAt', 'rating',
            'lastEmailAt'
          ])
          && request.resource.data.status in ['pending', 'in_progress', 'resolved']
          && request.resource.data.priority in ['low', 'medium', 'high', 'urgent'];
      }

      allow read: if isStaff() || isOwner(resource.data);
      allow create: if isMember() && validNewTicket(request.resource.data);
      allow update: if (isStaff() && validStaffUpdate())
        || (isOwner(resource.data)
            && (memberSendMessageShape() || memberMarkReadShape() || memberRatingShape()));
      allow delete: if false;

      // ---------- Messages ----------

      match /messages/{messageId} {

        function parentTicket() {
          return get(/databases/$(database)/documents/tickets/$(ticketId)).data;
        }

        function validMessageBase(data) {
          return data.keys().hasOnly(['type', 'senderId', 'senderName', 'senderRole', 'text', 'createdAt'])
            && data.senderId == request.auth.uid
            && isString(data.senderName, 1, 100)
            && isString(data.text, 1, 2000)
            && data.createdAt == request.time;
        }

        function validMemberMessage(data) {
          return isMember()
            && data.senderRole == 'member'
            && data.type == 'message'
            && parentTicket().memberId == request.auth.uid
            && parentTicket().status != 'resolved';
        }

        function validStaffMessage(data) {
          return isStaff()
            && ((data.senderRole == 'staff' && data.type == 'message')
                || (data.senderRole == 'system' && data.type == 'system'));
        }

        allow read: if isStaff() || isOwner(parentTicket());
        allow create: if validMessageBase(request.resource.data)
          && (validMemberMessage(request.resource.data) || validStaffMessage(request.resource.data));
        allow update, delete: if false;
      }
    }

    // ---------- Quick replies ----------

    match /quickReplies/{replyId} {

      function validQuickReplyFields(data) {
        return data.keys().hasOnly(['title', 'body', 'category', 'createdBy', 'createdAt', 'updatedAt'])
          && isString(data.title, 3, 60)
          && isString(data.body, 5, 1000)
          && (data.category in ticketCategories() || data.category == 'any')
          && data.updatedAt == request.time;
      }

      // Agents use quick replies; only admins manage them.
      allow read: if isStaff();
      allow create: if isAdmin()
        && validQuickReplyFields(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && validQuickReplyFields(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin();
    }

    // Everything else is denied by default (no other match blocks).
  }
}
