PORT=8080
# Comma-separated web origins allowed to call the service
ALLOWED_ORIGINS=http://localhost:5173
# Base URL used for the "Open conversation" links in emails
APP_URL=http://localhost:5173
# Number of reverse proxies in front of the service (1 on Render/Railway, 0 locally)
TRUST_PROXY=0

# Firebase Admin credentials: set ONE of these
# base64 of the service account JSON (for deploys): base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=
# or a path to the service account JSON file (local dev), e.g. ../scripts/service-account.json
GOOGLE_APPLICATION_CREDENTIALS=

# false = log an email preview instead of sending (no SMTP needed)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# Gmail app password, never your real password
SMTP_PASS=
MAIL_FROM="CarePal Support <your@gmail.com>"
# Fallback recipient for member replies when a ticket is unassigned
SUPPORT_INBOX_EMAIL=
THROTTLE_MINUTES=10
